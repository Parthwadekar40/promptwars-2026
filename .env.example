# Copy to .env and fill — NEVER commit .env
# Build-time key for the public demo deployment (injected into the bundle at build only).
VITE_GEMINI_API_KEY=

# Firebase web config (public-by-design — access is enforced by Firestore Security Rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=

# EmailJS (public key is designed to be client-side)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
